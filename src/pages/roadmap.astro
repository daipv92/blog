---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const roadmap = await getEntry("pages", "roadmap");

if (!roadmap) {
  throw new Error(
    "Missing content entry: `roadmap.md` or `roadmap.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(roadmap);
---

<Layout
  title={`${roadmap.data.title} | ${config.site.title}`}
  description={roadmap.data.description}
  ogImage={roadmap.data.ogImage}
  canonicalURL={roadmap.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={roadmap.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
