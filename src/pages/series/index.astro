---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { SERIES, SERIES_STATUS_LABEL } from "@/data/series";
import { getPostsBySeries } from "@/utils/getPostsBySeries";
import { useTranslations } from "@/i18n";
import config from "@/config";

// Unregistered series slugs fail at content-parse time via the schema
// refine in content.config.ts — no page-level guard needed here.
const posts = await getCollection("posts", ({ data }) => !data.draft);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.seriesTitle} | ${config.site.title}`}
  description={t.pages.seriesDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.seriesTitle} pageDesc={t.pages.seriesDesc}>
    <ul>
      {
        SERIES.map(series => {
          const published = getPostsBySeries(posts, series.slug);
          return (
            <li class="border-border my-8 border-b pb-8 last:border-b-0">
              <div class="flex items-baseline gap-3">
                <a
                  href={getRelativeLocaleUrl(locale, `series/${series.slug}`)}
                  class="text-accent text-xl font-semibold decoration-dashed underline-offset-4 hover:underline"
                >
                  {series.title}
                </a>
                <span class="border-border text-foreground border px-2 py-0.5 text-xs tracking-wide uppercase">
                  {SERIES_STATUS_LABEL[series.status]}
                </span>
              </div>
              <p class="mt-2 font-medium italic">{series.bigQuestion}</p>
              <p class="mt-1">{series.description}</p>
              <p class="mt-1 text-sm opacity-80">
                {published.length > 0
                  ? `${published.length} article${published.length === 1 ? "" : "s"} published`
                  : "No articles published yet"}
              </p>
            </li>
          );
        })
      }
    </ul>
  </Main>

  <Footer />
</Layout>
