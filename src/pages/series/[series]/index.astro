---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { SERIES, SERIES_STATUS_LABEL, type SeriesInfo } from "@/data/series";
import { getPostsBySeries } from "@/utils/getPostsBySeries";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  return SERIES.map(series => ({
    params: { series: series.slug },
    props: { series },
  }));
}

type Props = { series: SeriesInfo };

const { series } = Astro.props;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const seriesPosts = getPostsBySeries(posts, series.slug);

// Planned titles that don't match a published post title yet (exact,
// case-insensitive match; imperfect matches simply show in both lists
// until the registry is tidied — editorial upkeep, not a build concern).
const publishedTitles = new Set(
  seriesPosts.map(post => post.data.title.toLowerCase())
);
const comingTitles = (series.plannedTitles ?? []).filter(
  title => !publishedTitles.has(title.toLowerCase())
);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${series.title} | ${config.site.title}`}
  description={series.description}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={series.title} pageDesc={series.bigQuestion}>
    <div class="mb-8">
      <span
        class="border-border text-foreground border px-2 py-0.5 text-xs tracking-wide uppercase"
      >
        {SERIES_STATUS_LABEL[series.status]}
      </span>
      <p class="mt-4">{series.description}</p>
    </div>

    {
      seriesPosts.length > 0 && (
        <ul>
          {seriesPosts.map(post => (
            <Card variant="h2" {...post} />
          ))}
        </ul>
      )
    }

    {
      comingTitles.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold">{t.pages.seriesComingSoon}</h2>
          <ul class="mt-3 list-disc ps-5 opacity-80">
            {comingTitles.map(title => (
              <li class="my-1">{title}</li>
            ))}
          </ul>
        </section>
      )
    }
  </Main>

  <Footer />
</Layout>
